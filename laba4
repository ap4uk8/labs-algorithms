print("Введите числа через пробел:")
a = list(map(int, input().split()))

n = len(a)
gap = n
swapped = True

while gap > 1 or swapped:
    gap = int(gap / 1.3)
    gap = max(gap, 1)
    swapped = False
    for i in range(n - gap):
        if a[i] > a[i + gap]:
            a[i], a[i + gap] = a[i + gap], a[i]
            swapped = True

print("Отсортировано:", a)
